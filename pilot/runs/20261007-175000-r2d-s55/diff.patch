+def split_path(path: str | os.PathLike[str]) -> tuple[str, str]:
+    """Split a path textually into (head, tail), tail being the last component
+    (empty if the path ends with a separator). See `join_path`."""
+    path = os.fspath(path)
+    head, sep, tail = path.rpartition(os.sep)
+    head += sep
+    if head.strip(os.sep):
+        head = head.rstrip(os.sep)
+    return head, tail
