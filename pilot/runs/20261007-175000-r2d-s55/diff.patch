+def normalize_path(path: str | os.PathLike[str]) -> str:
+    """Lexically collapse ".", ".." and repeated separators in a path.
+
+    Unlike `Path.resolve()`, this never touches the filesystem and so doesn't
+    follow symlinks. An empty result is returned as ".".
+    """
+    path = pathlib.PurePath(path)
+    parts: list[str] = []
+    for part in path.parts[1 if path.anchor else 0 :]:
+        if part != "..":
+            parts.append(part)
+        elif parts and parts[-1] != "..":
+            parts.pop()
+        elif not path.anchor:
+            parts.append(part)
+    return str(pathlib.PurePath(path.anchor, *parts))
+
+
