+    def test_staticfiles_order_is_reproducible(self):
+        """Test that staticfiles are in a stable (sorted) order, rather than
+        the hash-dependent order of a set."""
+        names = [f"file{i:02d}.txt" for i in range(30)]
+        for name in names:
+            with open(os.path.join(self.temp_content, "static", name), "w") as f:
+                f.write("x")
+        context = get_context(self.settings)
+        context["static_links"] = {"static/file05.txt"}
+        StaticGenerator(
+            context=context,
+            settings=self.settings,
+            path=self.temp_content,
+            theme="",
+            output_path=self.temp_output,
+        ).generate_context()
+
+        self.assertEqual(
+            [os.path.basename(sf.source_path) for sf in context["staticfiles"]],
+            names,
+        )
+
     def test_static_exclude_sources(self):
         """Test that StaticGenerator respects STATIC_EXCLUDE_SOURCES."""
 
