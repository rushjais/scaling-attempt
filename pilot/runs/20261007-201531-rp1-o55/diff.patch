+    def test_staticfiles_order_is_deterministic(self):
+        """Test that static files are processed in a sorted, stable order,
+        independent of set iteration order (string hash randomization)."""
+        names = [f"file{i:02}.txt" for i in range(20)]
+        for name in names:
+            with open(os.path.join(self.temp_content, "static", name), "w") as f:
+                f.write(name)
+        with open(os.path.join(self.temp_content, "linked.txt"), "w") as f:
+            f.write("linked")
+        self.generator.context["static_links"] = {"linked.txt"}
+
+        self.generator.generate_context()
+
+        relpaths = [
+            os.path.relpath(c.source_path, self.temp_content)
+            for c in self.generator.context["staticfiles"]
+        ]
+        expected = ["linked.txt"] + [os.path.join("static", name) for name in names]
+        self.assertEqual(relpaths, expected)
+
