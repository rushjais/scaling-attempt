+def normalize_path(path: str | os.PathLike) -> pathlib.Path:
+    """Collapse ``..`` components of a path lexically.
+
+    Equivalent to ``os.path.normpath()``; pathlib itself only removes
+    redundant separators and ``.`` components.
+    """
+    path = pathlib.Path(path)
+    parts: list[str] = []
+    for part in path.parts[1:] if path.anchor else path.parts:
+        if part != "..":
+            parts.append(part)
+        elif parts and parts[-1] != "..":
+            parts.pop()
+        elif not path.root:
+            # leading ".." components are kept unless the path is rooted
+            parts.append(part)
+    return pathlib.Path(path.anchor, *parts)
+
+
+def absolute_path(path: str | os.PathLike) -> pathlib.Path:
+    """Return an absolute, normalized version of a path.
+
+    Equivalent to ``os.path.abspath()``: ``..`` components are collapsed
+    lexically, without resolving symbolic links (unlike ``Path.resolve()``).
+    """
+    return normalize_path(pathlib.Path(path).absolute())
+
+
+def relative_path(
+    path: str | os.PathLike, start: str | os.PathLike = "."
+) -> pathlib.Path:
+    """Return a relative version of a path, walking up with ``..`` if needed.
+
+    Equivalent to ``os.path.relpath()``; ``Path.relative_to(walk_up=True)``
+    is not available before Python 3.12.
+    """
+    if not os.fspath(path):
+        raise ValueError("no path specified")
+    abs_path = absolute_path(path)
+    abs_start = absolute_path(start)
+    if pathlib.PurePath(abs_path.drive) != pathlib.PurePath(abs_start.drive):
+        raise ValueError(
+            f"path is on mount {abs_path.drive!r}, start on mount {abs_start.drive!r}"
+        )
+    path_parts = abs_path.parts[1:]
+    start_parts = abs_start.parts[1:]
+    common = 0
+    for path_part, start_part in zip(path_parts, start_parts):
+        # PurePath comparison is case-insensitive on Windows, like os.path
+        if pathlib.PurePath(path_part) != pathlib.PurePath(start_part):
+            break
+        common += 1
+    return pathlib.Path(
+        *[os.pardir] * (len(start_parts) - common), *path_parts[common:]
+    )
+
+
+def split_extension(path: str | os.PathLike) -> tuple[str, str]:
+    """Split the final component of a path into its stem and extension.
+
+    Same semantics as ``os.path.splitext()``, which differ from
+    ``Path.stem``/``Path.suffix`` for names with leading or trailing dots.
+    """
+    name = pathlib.Path(path).name
+    index = name.rfind(".")
+    if index > 0 and name[:index].lstrip("."):
+        return name[:index], name[index:]
+    return name, ""
+
+
+def expand_user(path: str | os.PathLike) -> pathlib.Path:
+    """Expand ``~`` and ``~user``, leaving the path unchanged if that fails."""
+    path = pathlib.Path(path)
+    try:
+        return path.expanduser()
+    except RuntimeError:
+        return path
