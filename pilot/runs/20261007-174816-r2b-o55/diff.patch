+def _ends_with_separator(path):
+    """Return whether a path setting is spelled with a trailing separator."""
+    # Plain string handling: this inspects the spelling, which pathlib drops.
+    return isinstance(path, str) and path[-1:] in (os.sep, os.altsep)
+
+
+def _is_excludable(exclude):
+    """Return whether an *_EXCLUDES path can match a directory in get_files().
+
+    Excluded directories used to be found by comparing spellings, so those
+    whose parent was spelled with "." components (say) never matched, nor
+    did those with an empty or "." name (a trailing separator, say).
+    """
+    if not isinstance(exclude, str):
+        return True
+    # Plain string handling: this inspects the spelling, which pathlib drops.
+    # Appending a character makes the last component a name pathlib keeps.
+    name = PurePath(exclude + "_").name[:-1]
+    parent = exclude[: len(exclude) - len(name)]
+    while _ends_with_separator(parent) and len(parent) > 1:
+        parent = parent[:-1]
+    return name not in ("", os.curdir, os.pardir) and (
+        _ends_with_separator(parent) or is_normalized(parent)
+    )
+
